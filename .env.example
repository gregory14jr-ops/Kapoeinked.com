# Copy this file to .env for local development (vercel dev), or set these as
# Environment Variables in the Vercel project dashboard for production.
#
# Powers the Booking Request and Tattoo Idea forms on chat.html — they email
# the details to Artisansrefuge@gmail.com. Without these set, both forms show
# a friendly "not set up yet" message and point visitors to Instagram instead.
#
# The Gmail account that sends the email (must be Artisansrefuge@gmail.com,
# or another account you want sending on its behalf):
GMAIL_USER=Artisansrefuge@gmail.com
#
# A Gmail App Password (NOT the regular account password). To generate one:
# 1. Turn on 2-Step Verification for this Gmail account (myaccount.google.com/security)
# 2. Go to myaccount.google.com/apppasswords
# 3. Create an app password named "Kapoe Inked Website" and paste it below
GMAIL_APP_PASSWORD=your16characterapppassword
