# Copy this file to .env for local development (vercel dev), or set these as
# Environment Variables in the Vercel project dashboard for production.
#
# Powers the Booking Request and Tattoo Idea forms on chat.html — they text
# the details to Kapoe via Twilio SMS. Without these set, both forms show a
# friendly "not set up yet" message and point visitors to Instagram instead.
#
# From your Twilio Console (https://console.twilio.com):
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# A Twilio phone number capable of sending SMS (bought/verified in Twilio):
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# The phone number that should receive booking/idea notifications.
OWNER_PHONE_NUMBER=+1XXXXXXXXXX
